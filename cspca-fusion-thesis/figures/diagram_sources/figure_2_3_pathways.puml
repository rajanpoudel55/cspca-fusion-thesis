@startuml
top to bottom direction
hide stereotype
skinparam shadowing false
skinparam backgroundColor white
skinparam defaultFontName "Times New Roman"
skinparam defaultFontSize 13
skinparam roundCorner 12
skinparam ArrowThickness 1.5
skinparam rectangle {
  FontColor #111827
  BorderThickness 1.4
}
skinparam rectangle<<t>> {
  BackgroundColor #F3F4F6
  BorderColor #6B7280
}
skinparam rectangle<<m>> {
  BackgroundColor #EEF1F4
  BorderColor #5B7A94
}
skinparam rectangle<<l>> {
  BackgroundColor #EEF2EF
  BorderColor #80A09B
}
skinparam rectangle<<tp>> {
  BackgroundColor #FFFFFF
  BorderColor #6B7280
  FontColor #6B7280
}
skinparam rectangle<<mp>> {
  BackgroundColor #FFFFFF
  BorderColor #5B7A94
  FontColor #5B7A94
}
skinparam rectangle<<lp>> {
  BackgroundColor #FFFFFF
  BorderColor #80A09B
  FontColor #4F7F78
}
skinparam legend {
  BackgroundColor white
  BorderColor white
  FontSize 11
  FontColor #6B7280
}

rectangle "**Traditional pathway**" as P1 <<tp>> {
  rectangle "Raised PSA or\nabnormal DRE" as T1 <<t>>
  rectangle "Systematic\nTRUS biopsy" as T2 <<t>>
  rectangle "Histopathology" as T3 <<t>>
}

rectangle "**MRI-based pathway**" as P2 <<mp>> {
  rectangle "Raised PSA" as M1 <<m>>
  rectangle "Pre-biopsy MRI\n(PI-RADS score)" as M2 <<m>>
  rectangle "Targeted ± \nsystematic biopsy" as M3 <<m>>
  rectangle "Histopathology" as M4 <<m>>
}

rectangle "**Machine learning-assisted pathway (this thesis)**" as P3 <<lp>> {
  rectangle "Clinical variables\n(age, PSA, PSAD,\nvolume)" as L1 <<l>>
  rectangle "MRI features and\nPI-RADS score" as L2 <<l>>
  rectangle "Model estimate of\ncsPCa risk" as L3 <<l>>
  rectangle "Biopsy decision\nsupport" as L4 <<l>>
}

T1 -right[#6B7280]-> T2
T2 -right[#6B7280]-> T3

M1 -right[#5B7A94]-> M2
M2 -right[#5B7A94]-> M3
M3 -right[#5B7A94]-> M4

L1 -right[#80A09B]-> L2
L2 -right[#80A09B]-> L3
L3 -right[#80A09B]-> L4

note bottom of M2 #FFFFFF
  <i>A negative MRI may allow biopsy to be avoided</i>
  <i>(PROMIS: up to 27% of men)</i>
end note

T1 -[hidden]down-> M1
M1 -[hidden]down-> L1

legend bottom left
  TRUS: transrectal ultrasound; DRE: digital rectal examination; PSAD: PSA density.
endlegend
@enduml
