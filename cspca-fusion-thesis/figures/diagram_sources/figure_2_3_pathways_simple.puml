@startuml
skinparam shadowing false
skinparam defaultFontSize 13
skinparam roundCorner 12
skinparam packageStyle rectangle
skinparam ArrowThickness 1.5
skinparam rectangleBorderThickness 1.4

package "Traditional pathway" {
  rectangle "Raised PSA or\nabnormal DRE" as T1 #F3F4F6
  rectangle "Systematic\nTRUS biopsy" as T2 #F3F4F6
  rectangle "Histopathology" as T3 #F3F4F6
}

package "MRI-based pathway" {
  rectangle "Raised PSA" as M1 #EEF1F4
  rectangle "Pre-biopsy MRI\n(PI-RADS score)" as M2 #EEF1F4
  rectangle "Targeted +/-\nsystematic biopsy" as M3 #EEF1F4
  rectangle "Histopathology" as M4 #EEF1F4
}

package "Machine learning-assisted pathway (this thesis)" {
  rectangle "Clinical variables\n(age, PSA, PSAD,\nvolume)" as L1 #EEF2EF
  rectangle "MRI features and\nPI-RADS score" as L2 #EEF2EF
  rectangle "Model estimate of\ncsPCa risk" as L3 #EEF2EF
  rectangle "Biopsy decision\nsupport" as L4 #EEF2EF
}

T1 -right-> T2
T2 -right-> T3
M1 -right-> M2
M2 -right-> M3
M3 -right-> M4
L1 -right-> L2
L2 -right-> L3
L3 -right-> L4

T1 -[hidden]down-> M1
M1 -[hidden]down-> L1

note bottom of M2
  A negative MRI may allow biopsy to be avoided
  (PROMIS: up to 27% of men)
end note

note as N
  TRUS: transrectal ultrasound; DRE: digital rectal examination; PSAD: PSA density.
end note
L1 -[hidden]down-> N
@enduml
